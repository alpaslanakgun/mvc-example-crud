@model IEnumerable<MvcCrudOperation.Models.Urun>

<h2>Ürünler</h2>
<a asp-action="Create">Yeni Ürün Ekle</a>

<hr>

<table border="1" cellpadding="6">

    <thead>
        <tr>
            <th>Id</th>
            <th>Ürün Adı</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
              <td>@item.Id</td>
                <td>@item.UrunAdi</td>
                <td>@item.Fiyat.ToString("C")</td>
                <td>@item.Stok</td>
                <td>@item.Kategori?.KategoriAdi</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                </td>
            </tr>

        }



    </tbody>


</table>

